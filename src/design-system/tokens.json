{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Obsidian Photon Design System",
  "version": "1.0.0",
  "color": {
    "brand": {
      "cobalt": {
        "$value": "#0016F9",
        "$type": "color",
        "$description": "Primary brand anchor and interactive accent"
      },
      "violet": {
        "$value": "#6D28D9",
        "$type": "color",
        "$description": "Mid-spectrum transition gradient anchor"
      },
      "crimson": {
        "$value": "#D10D04",
        "$type": "color",
        "$description": "Secondary energetic brand accent"
      },
      "gradient": {
        "$value": "linear-gradient(135deg, #0016F9 0%, #6D28D9 52%, #D10D04 100%)",
        "$type": "gradient",
        "$description": "Signature tri-color dynamic brand gradient"
      }
    },
    "dark": {
      "canvas": { "$value": "#0B0C10", "$type": "color" },
      "elevated": { "$value": "#14161F", "$type": "color" },
      "card": { "$value": "#1C1D25", "$type": "color" },
      "cardHover": { "$value": "#232530", "$type": "color" },
      "glass": { "$value": "rgba(20, 22, 31, 0.78)", "$type": "color" },
      "textPrimary": { "$value": "#F8FAFC", "$type": "color" },
      "textSecondary": { "$value": "#94A3B8", "$type": "color" },
      "textMuted": { "$value": "#64748B", "$type": "color" },
      "borderSubtle": { "$value": "rgba(255, 255, 255, 0.08)", "$type": "color" },
      "borderStrong": { "$value": "rgba(255, 255, 255, 0.16)", "$type": "color" },
      "shadowElevated": { "$value": "0 24px 48px -12px rgba(0, 0, 0, 0.65)", "$type": "shadow" }
    },
    "light": {
      "canvas": { "$value": "#F8FAFC", "$type": "color" },
      "elevated": { "$value": "#F1F5F9", "$type": "color" },
      "card": { "$value": "#FFFFFF", "$type": "color" },
      "cardHover": { "$value": "#F8FAFC", "$type": "color" },
      "glass": { "$value": "rgba(255, 255, 255, 0.85)", "$type": "color" },
      "textPrimary": { "$value": "#0F172A", "$type": "color" },
      "textSecondary": { "$value": "#475569", "$type": "color" },
      "textMuted": { "$value": "#64748B", "$type": "color" },
      "borderSubtle": { "$value": "rgba(15, 23, 42, 0.09)", "$type": "color" },
      "borderStrong": { "$value": "rgba(15, 23, 42, 0.18)", "$type": "color" },
      "shadowElevated": { "$value": "0 20px 40px -15px rgba(15, 23, 42, 0.10)", "$type": "shadow" }
    },
    "semantic": {
      "success": { "$value": "#10B981", "$type": "color" },
      "warning": { "$value": "#F59E0B", "$type": "color" },
      "error": { "$value": "#EF4444", "$type": "color" },
      "info": { "$value": "#22D3EE", "$type": "color" }
    }
  },
  "typography": {
    "fontFamily": {
      "display": { "$value": "Syne, League Spartan, sans-serif", "$type": "fontFamily" },
      "body": { "$value": "Plus Jakarta Sans, -apple-system, BlinkMacSystemFont, sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "JetBrains Mono, monospace", "$type": "fontFamily" }
    },
    "fontSize": {
      "hero": { "$value": "3.5rem", "$type": "dimension" },
      "h1": { "$value": "2.25rem", "$type": "dimension" },
      "h2": { "$value": "1.75rem", "$type": "dimension" },
      "h3": { "$value": "1.25rem", "$type": "dimension" },
      "bodyLg": { "$value": "1.0625rem", "$type": "dimension" },
      "body": { "$value": "0.9375rem", "$type": "dimension" },
      "bodySm": { "$value": "0.8125rem", "$type": "dimension" },
      "caption": { "$value": "0.75rem", "$type": "dimension" },
      "micro": { "$value": "0.6875rem", "$type": "dimension" }
    },
    "fontWeight": {
      "regular": { "$value": "400", "$type": "fontWeight" },
      "medium": { "$value": "500", "$type": "fontWeight" },
      "semibold": { "$value": "600", "$type": "fontWeight" },
      "bold": { "$value": "700", "$type": "fontWeight" },
      "extrabold": { "$value": "800", "$type": "fontWeight" }
    }
  },
  "spacing": {
    "xs": { "$value": "0.25rem", "$type": "dimension" },
    "sm": { "$value": "0.5rem", "$type": "dimension" },
    "md": { "$value": "1.0rem", "$type": "dimension" },
    "lg": { "$value": "1.5rem", "$type": "dimension" },
    "xl": { "$value": "2.5rem", "$type": "dimension" },
    "2xl": { "$value": "4.0rem", "$type": "dimension" }
  },
  "radii": {
    "none": { "$value": "0px", "$type": "dimension" },
    "xs": { "$value": "4px", "$type": "dimension" },
    "sm": { "$value": "8px", "$type": "dimension" },
    "md": { "$value": "12px", "$type": "dimension" },
    "lg": { "$value": "16px", "$type": "dimension" },
    "xl": { "$value": "20px", "$type": "dimension" },
    "2xl": { "$value": "24px", "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },
  "transition": {
    "snappy": { "$value": "160ms cubic-bezier(0.16, 1, 0.3, 1)", "$type": "transition" },
    "smooth": { "$value": "350ms cubic-bezier(0.16, 1, 0.3, 1)", "$type": "transition" }
  }
}
